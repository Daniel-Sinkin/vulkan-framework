#version 450

layout(local_size_x = 128) in;

struct Particle
{
    vec4 position_radius;
    vec4 previous_density;
    vec4 velocity_lambda;
    vec4 delta_neighbors;
};

struct SimParams
{
    vec4 domain_min_dt;
    vec4 domain_max_radius;
    vec4 gravity_rest_density;
    vec4 kernel_poly6_spiky;
    vec4 pbf_params;
    vec4 viscosity_vorticity;
    uvec4 counts;
    uvec4 grid_size;
};

layout(std430, set = 0, binding = 0) buffer Particles
{
    Particle particles[];
};
layout(std430, set = 0, binding = 1) readonly buffer CellCounts
{
    uint cell_counts[];
};
layout(std430, set = 0, binding = 2) readonly buffer CellParticles
{
    uint cell_particles[];
};
layout(std430, set = 0, binding = 3) readonly buffer ParamsBuffer
{
    SimParams params;
};
float poly6(float r2)
{
    const float h = params.kernel_poly6_spiky.z;
    const float h2 = h * h;
    if (r2 >= h2)
    {
        return 0.0;
    }
    const float x = h2 - r2;
    return params.kernel_poly6_spiky.x * x * x * x;
}

vec3 spiky_grad(vec3 r)
{
    const float d = length(r);
    const float h = params.kernel_poly6_spiky.z;
    if (d <= 1.0e-6 || d >= h)
    {
        return vec3(0.0);
    }
    const float x = h - d;
    return params.kernel_poly6_spiky.y * x * x * (r / d);
}

uvec3 cell_for_position(vec3 p)
{
    const vec3 rel = (p - params.domain_min_dt.xyz) / params.kernel_poly6_spiky.z;
    return clamp(uvec3(floor(rel)), uvec3(0u), params.grid_size.xyz - uvec3(1u));
}

uint flatten_cell(uvec3 c)
{
    return c.x + params.grid_size.x * (c.y + params.grid_size.y * c.z);
}

vec3 boundary_delta(vec3 r, float lambda_i, float scorr_ref)
{
    const float w = poly6(dot(r, r));
    if (w <= 0.0)
    {
        return vec3(0.0);
    }
    const float corr_ratio = w / scorr_ref;
    const float scorr = -params.pbf_params.y * pow(corr_ratio, params.pbf_params.w);
    return (lambda_i + scorr) * spiky_grad(r);
}

vec3 boundary_correction(vec3 x, float lambda_i, float scorr_ref)
{
    const float radius = params.domain_max_radius.w;
    const vec3 lower = params.domain_min_dt.xyz + vec3(radius);
    const vec3 upper = params.domain_max_radius.xyz - vec3(radius);
    const vec3 lower_distance = x - lower;
    const vec3 upper_distance = upper - x;

    vec3 delta = vec3(0.0);
    delta += boundary_delta(vec3(2.0 * lower_distance.x, 0.0, 0.0), lambda_i, scorr_ref);
    delta += boundary_delta(vec3(-2.0 * upper_distance.x, 0.0, 0.0), lambda_i, scorr_ref);
    delta += boundary_delta(vec3(0.0, 2.0 * lower_distance.y, 0.0), lambda_i, scorr_ref);
    delta += boundary_delta(vec3(0.0, -2.0 * upper_distance.y, 0.0), lambda_i, scorr_ref);
    delta += boundary_delta(vec3(0.0, 0.0, 2.0 * lower_distance.z), lambda_i, scorr_ref);
    delta += boundary_delta(vec3(0.0, 0.0, -2.0 * upper_distance.z), lambda_i, scorr_ref);
    return delta;
}

void main()
{
    const uint id = gl_GlobalInvocationID.x;
    if (id >= params.counts.x)
    {
        return;
    }

    const vec3 xi = particles[id].position_radius.xyz;
    const float lambda_i = particles[id].velocity_lambda.w;
    const uvec3 base_cell = cell_for_position(xi);
    const float mass = params.kernel_poly6_spiky.w;
    const float inv_rho0 = 1.0 / params.gravity_rest_density.w;
    const float scorr_ref = max(poly6(params.pbf_params.z * params.pbf_params.z), 1.0e-6);
    vec3 delta = vec3(0.0);

    for (int dz = -1; dz <= 1; ++dz)
        for (int dy = -1; dy <= 1; ++dy)
            for (int dx = -1; dx <= 1; ++dx)
            {
                const ivec3 ic = ivec3(base_cell) + ivec3(dx, dy, dz);
                if (any(lessThan(ic, ivec3(0)))
                    || any(greaterThanEqual(ic, ivec3(params.grid_size.xyz))))
                {
                    continue;
                }
                const uint cell = flatten_cell(uvec3(ic));
                const uint count = min(cell_counts[cell], params.counts.z);
                for (uint slot = 0u; slot < count; ++slot)
                {
                    const uint j = cell_particles[cell * params.counts.z + slot];
                    if (j == id)
                    {
                        continue;
                    }
                    const vec3 r = xi - particles[j].position_radius.xyz;
                    const float r2 = dot(r, r);
                    const float w = poly6(r2);
                    if (w <= 0.0)
                    {
                        continue;
                    }
                    const float corr_ratio = w / scorr_ref;
                    const float scorr = -params.pbf_params.y * pow(corr_ratio, params.pbf_params.w);
                    delta += (lambda_i + particles[j].velocity_lambda.w + scorr) * spiky_grad(r);
                }
            }

    delta += boundary_correction(xi, lambda_i, scorr_ref);
    delta *= mass * inv_rho0;
    Particle p = particles[id];
    p.delta_neighbors.xyz = delta;
    particles[id] = p;
}
