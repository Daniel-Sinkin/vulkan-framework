# Large/generated simulation data. New DFSPH scenes are local cache data by
# default; force-add only tiny metadata/docs intentionally.
assets/dfsph/*/
!assets/dfsph/README.md
assets/dfsph/**/vtk/
assets/dfsph/**/surface/frames/
assets/dfsph/**/*.vtk
assets/dfsph/**/*.mesh.gz
assets/dfsph/**/*.bin
assets/dfsph/**/*.bin.gz

# Local HDRI look-dev assets. Keep the tiny tracked smoke-test studio HDRI, but
# do not stage extra downloaded environments by default.
assets/hdri/polyhaven/*.hdr
!assets/hdri/polyhaven/studio_small_01_1k.hdr

# Local Quake source data cache.
app/quake/assets/
app/quake/outputs/

# Local-only realtime SPH research notes and papers.
app/realtime-sph/research/
